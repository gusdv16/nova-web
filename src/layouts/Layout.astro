---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/bebas-neue/latin-400.css';
import interUrl from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import bebasUrl from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/home.css';

const {
  title = 'NOVA — A cosmic cat in a world of dogs',
  description = 'A cinematic, animation-driven landing page built with Astro, GSAP and Lenis. Portfolio piece by Gustavo Bentancor.',
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const origin = Astro.site ?? new URL('https://example.com');
const canonical = new URL(base, origin).href;
const ogImage = new URL(`${base}og.jpg`, origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0612" />
    <meta name="author" content="Gustavo Bentancor" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fuentes autoalojadas: sin pedidos a terceros; se precargan las dos que se usan arriba -->
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bebasUrl} crossorigin />

    <!-- Marca la página como "cargando" hasta que termine el preloader; si el JS fallara, se libera a los 6 s -->
    <script is:inline>
      document.documentElement.classList.add('js-pre');
      setTimeout(function () {
        document.documentElement.classList.remove('js-pre');
        var p = document.getElementById('preloader');
        if (p) p.classList.add('done');
      }, 6000);
    </script>

    <noscript>
      <style>
        .preloader { display: none !important; }
        .reveal { opacity: 1 !important; transform: none !important; }
        .burger { display: none !important; }
        .nav-links { display: flex !important; }
      </style>
    </noscript>
  </head>
  <body class="grain">
    <div class="preloader" id="preloader" aria-hidden="true">
      <div class="preloader-inner">
        <div class="preloader-logo display">NOVA</div>
        <div class="preloader-bar"><span></span></div>
        <div class="preloader-text">initializing cosmos…</div>
      </div>
    </div>
    <div class="scroll-progress" id="scrollProgress"></div>
    <canvas class="fx" id="fx" aria-hidden="true"></canvas>
    <div class="cursor" id="cursor" aria-hidden="true"><span id="cursorLabel"></span></div>
    <div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
